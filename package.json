{
  "name": "tavishi-careers",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "node --test tests/",
    "dev:config": "node scripts/start-with-config.mjs --profile dev --mode dev",
    "qa:build": "node scripts/start-with-config.mjs --profile qa --mode build",
    "prod:build": "node scripts/start-with-config.mjs --profile prod --mode build",
    "prod:start": "node scripts/start-with-config.mjs --profile prod --mode start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^15.5.0",
